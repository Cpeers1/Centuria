{
    // PR security verification config
    // Used to verify PR requests

    // This allows specific files to be defined that are considered secure
    // Secure files can only be edited by individuals trusted to edit them based on gpg signing keys in a keychain

    // Verification is case-insensitive, and paths are heavily sanitized
    // Its always relative to the root project
    // Patterns are supported
    // Always uses UNIX paths (/ separator)

    // Base config
    "config": {
        // Keychain folder
        // Keychains are folders within the keychain folder with a name and a set of gpg keys
        "keychain-folder": ".reposafety/keychains"
    },

    // Levels for sensitivity and their keychains for individuals that do not need authorization
    // Individuals in the keychain can submit prs without having to have the files reviewed
    "levels": {
        // "Review required" level
        // Used for general verification
        "reviewrequired": [
            "trusted-reviewers",
            "trusted-maintainers"
        ],

        // "Secure file" level
        // Used for project settings files that eg. provide security
        // Only trusted maintainers may edit these files
        "securefile": [
            "trusted-maintainers"
        ],

        // Rejectt level
        "reject": []
    },

    // Authorization control per level
    // If present for a level, the given keychains are used to allow specific individuals to "authorize" a pull request, bypassing verification
    // If absent, bypassing is impossible
    "authorization": {
        "reviewrequired": [
            "trusted-maintainers",
            "trusted-reviewers"
        ],
        "securefile": [
            "trusted-maintainers"
        ]
    },

    // Secure file definitions for each level
    "secure-files": {
        // Files requiring a maintainer to authorize
        "securefile":  [
            // Secure files
            "prcheckerfile.json",

            // Securefile settings
            ".reposafety/",
            
            // PolyTool related
            "polyfile.pcb",
            "project/dependencies/",
            "project/tasks/",

            // Polytool
            "polytool",
            "polytool.properties",

            // License
            "LICENSE.txt",

            // Gradle
            "gradle/",
            "gradlew",
            "gradlew.bat",

            // Gitignore
            ".gitignore",
            ".gitattributes",

            // Skeleton files
            "skel/devenv/build.settings.json",
            "skel/devenv/buildinfo.json",

            // XPM build skeletons
            "skel/devenv/packagebuildartifacts.json",
            "skel/devenv/packagebuildchannels.json",

            // XPM repository settings
            "skel/devenv/repositorysettings.json",

            // URLs
            "skel/devenv/urls.json",

            // Build settings
            "build.settings.json",
            "settings/buildbranches.settings.json",
            "settings/buildpackages.settings.json",
            "settings/buildsettings.settings.json",
            "settings/buildinfogen.settings.json",
            "settings/githubrelease.settings.json",
            "settings/versionincrement.settings.json",
            "settings/deployment.settings.json",
            "autoff.json",

            // Github
            ".github/"
        ],

        // Files requiring a trusted reviewer to authorize
        "reviewrequired": [
            // Version polyfile
            "version.pcb",

            // Version control
            "settings/versioncontrol.json",

            // Credits
            "credits.txt",

            // Readme
            "README.md",

            // Skeleton files in general
            "skel/",

            // Specific build settings
            "skel/devenv/packagebuildsettings.json",
            "skel/devenv/packagesettings.json",

            // Script assets
            "assets/scripts"
        ],

        // Files to always reject
        "reject": [
            // Build
            "build/",

            // Gradle caches
            ".gradle/",

            // Dependency cache
            "deps/",

            // Binaries and ide stuff
            "bin/",
            ".settings/",
            ".classpath",
            ".project",

            // Intellij
            "*.iml",
            "*.ipr",
            "*.iws",
            "out/",

            // Run
            "run/",
            "saves/",

            // Polytool
            ".polytool/",
            ".polytool-version",
            "polylocal/",

            // Environment
            "environment/",

            // Build info cache
            "currentbuildinfo.json",
            "src/main/resources/buildinfo.json",
            ".buildinfo/cache/"
        ]
    }

}