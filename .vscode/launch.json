{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // Run
        {
            "type": "java",
            "name": "Centuria Server Environment (Vanilla)",
            "request": "launch",
            "console": "internalConsole",
            "mainClass": "org.asf.centuria.Centuria",
            "cwd": "${workspaceFolder}/run",
            "classPaths": ["$Test","$Runtime"],
            "vmArgs" : "-DdebugMode -DaddCpModules=org.asf.centuria.TestModule",
            "projectName": "Centuria Legacy-${workspaceFolderBasename}"
        },
        {
            "type": "java",
            "name": "Centuria Server Updater (Vanilla)",
            "request": "launch",
            "console": "internalConsole",
            "mainClass": "org.asf.centuria.CenturiaUpdater",
            "args": ["--update"],
            "cwd": "${workspaceFolder}/run",
            "classPaths": ["$Test","$Runtime"],
            "vmArgs" : "-DdebugMode -DaddCpModules=org.asf.centuria.TestModule",
            "projectName": "Centuria Legacy-${workspaceFolderBasename}"
        }
    ]
}