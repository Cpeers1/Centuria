{
    // Package settings for the XPM package to produce

    // Package details
    "id": "{polyfile.id}",
    "name": "{polyfile.name}",

    // Package implements statements
    // Basically aliases for this package, and to tell other packages that the local package can be used instead of the one they are targeting
    "implements": [
        "centuria",
        "centuria-legacy",
        "centuria-server"
    ],

    // Aliases are used by search to find packages
    // An alias can be used to help have variations of the package name that lead to the same pacakge
    "aliases": [
        "centuria",
        "centuria-legacy",
        "centuria-server"
    ],

    // Query tags
    // Query tags can be used to filter packages by categories
    "query-tags": [
        "server-software",
        "server-software/feral"
    ]
}