{
    // XPM package artifacts to produce for the project

    // Base server
    // Note that the artifact id mentioned here (base) is not available outside build, as XPM saves artifacts as hashes of the content list
    "base": {
        // Artifact type
        // Accepts "always" (artifact always included as long as tags match), "typed" (included as long as the engine preferred artifact types match the artifact), "fallback" (included when the engine preferred artifact types didnt match any artifact)
        "type": "always",

        // Required artifact?
        // If this is true, the artifact is required and always included, the dependencies will be treated as package dependencies
        // If false, the artifact is only included if dependencies are met
        "required": true,

        // Artifact content type
        // Supports "folder" or "file"
        "contenttype": "folder",

        // Artifact content source
        // Relative to script cwd, this case root script as its imported as an overload
        "source": "build/package-temp/unsigned/{polyfile.id}",

        // Tags to assign
        // Tags are value-bearing objects
        "tags": {},

        // Artifact types
        // These are used to help XPM locate compatible artifacts
        // Types are similar to tags but more specific to eg. artifact file types
        //
        // Examples for artifact control:
        //  Example types used by centuria:
        //  - server - server artifact type
        //  - client - client artifact type
        //  - contentserver - contentserver artifact type
        //  - launcher - launcher artifact type
        //  - payload - content to install into the base server / base client (used by server and launcher)
        //  - contentoverrides - content to install into the content delivery server (used by server and launcher)
        //  - server-module - modules to install into the server (used by server)
        //  - java-library - java library
        //  - ftm - feraltweaks mods to install into the server (used by server and launcher)
        //  Example tags used by centuria:
        //  - launcher - artifacts used by the launcher
        //  - server - artifacts to install into the server (used to filter by side)
        //  - client - artifacts to install into the client (used to filter by side)
        //  - payload - content folder to install into the base server / base client (used only to determine where to install)
        //  - contentoverrides - content to install into the content delivery server (used only to determine where to install and to filter by type)
        //  - library - server/client libraries to install (used only to determine where to install)
        //  - module - server modules to install (used only to determine where to install and to filter by type)
        //  - extension - launcher extensions artifacts (used only to determine where to install and to filter by type)
        //  - jar - jar file artifacts (used only to determine where to install)
        //  - xpk - xpk file artifacts (used only to determine where to install)
        //  - ftm - ftm file artifacts (used only to determine where to install and to filter by type)
        //  - lpk - launcher core package format (used only to determine where to install)
        //
        // The difference between tags and types is how they are required
        // Types are used to define requirements for each setup, providing required tags and such
        // Whereas tags are used to filter available packages based on tags
        //
        // Tags are also used to eg. figure out where to install specific artifacts
        //
        "artifactTypes": {
            // Server type, we are a server package
            "server": {
                "require-tags": [
                    "server"
                ],
                "tags": {
                    "payload": true
                }
            },

            // Type 'payload', as we install base content
            "payload": {
                // Required tags for this artifact to activate while on this type
                // We only support the server, so mark it as server
                //
                // This means that when XPM is queried with `payload` (eg. the mod browser), only the server can find this package
                // This package would be excluded when on the client
                "require-tags": [
                    "server"
                ],

                // Tags to assign while on this type
                "tags": {
                    "payload": true
                }
            }
        },

        // Dependencies
        "dependencies": "{devenv.versioncontrol.dependencies}",

        // Recommended packages
        "recommendedPackages": "{devenv.versioncontrol.recommendedPackages}"
    },

    // Development artifact
    // FIXME: test
    "dev": {
        // Artifact type
        "type": "always",

        // Required artifact?
        "required": true,

        // Artifact content type
        "contenttype": "folder",

        // Artifact content source
        // FIXME

        // Activate when tags are present
        // These are conditionals, if any of the expressions match, this artifact is valid
        // The outer array here acts as an ELSE list, any expression that matches makes this artifact valid
        // Accepts json string arrays or a single entry
        // Any match, or none present = valid
        "require-tags": [
            // Sub-arrays are AND expressions
            // Eg. having two tags present here will require both to be defined
            // We can also just use "dev" without an array, but lets for syntax's sake keep it in
            [ "dev" ]

            // Examples
            // "dev" - tag "dev" is required
            // [ "dev", "test2" ] - both "dev" and "test2" required
            // [ {"dev":true}, "test2" ] - require "dev" with value "true", and test2 to be present overall
            // {"dev":true} - just require "dev" with value "true"
            // {"dev":true,"test2":false} - require dev to be true and test2 to be false
        ],

        // Define tags
        "tags": {
            // Dev artifact
            "dev": true
        }
    }
}