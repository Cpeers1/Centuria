{
    // Build info
    "version": "{build.version}",
    "manifest": "{devenv.buildinfo}",

    // Changelog
    "changelogFile": "changelogs/{polyfile.version}.md",

    // Metadata
    // Package metadata is mostly available to XPM clients such as graphical interfaces
    "metadata": {
        "full_description": "Centuria is a work-in-progress server emulator for the now-defunct MMORPG Fer.al. Developed by Nexus Emulation from within the Fer.ever project, Centuria is a fan-run server designed to bring back the MMO game that recently shut down.", // Full description // FIXME: maybe use markdown file
        "short_description": "Server emulator software for the defunct MMORPG Fer.al.", // Displayed in short contexts (eg. a list)
        "project_page": "{devenv.urls.repopage}", // Project page
        // "icon": "https://url/to/icon", // Icon // FIXME
        "author": "The OpenFeral Team, Nexus Emulation", // Author
        "author_page": "{devenv.urls.repoauthorpage}" // Author page
    },

    // Vulnerability disclosure / alerting
    // Controls if this version should be avoided by XPM and if upgrades should be urged
    "vulnerabilitiesPresent": "{devenv.versioncontrol.vulnerabilitiesPresent}",
    "vulnerabilitiesPresentRequireUpgrade": "{devenv.versioncontrol.vulnerabilitiesPresentRequireUpgrade}",

    // List of vulnerabilities and their details
    // Expects: vulnerability identifiers and description messages
    "vulnerabilitiesDetails": "{devenv.versioncontrol.vulnerabilitiesDetails}",

    // Build breaking version data
    // Used for dependencies to have better version control for what they depend on
    // Eg. modules can add version requirements for specific parts of the server
    // If used properly, downgrades will still eg. use latest compatible, and avoid versions that introduce breaking changes that would break compatibility
    // This statement defines the local packages component versions that are used by projects depending on the local project to ensure compatibility
    "breakingVersions": "{build.breakingversions}",

    // Data versions
    // These prevent downgrading to eg. incompatible player data
    "dataVersions": "{build.dataversions}",

    // Recommended packages
    // These are packages installed in recommended mode when using eg. a graphical installer, or listed as recommended extras on XPM
    "recommendedPackages": []
}