{
    // Base properties
    // Mostly just loaded as strings
    "name": "{polyfile.name}",
    "version": "{build.version}",
    "version_title": "{build.versiontitle}",

    // Version info
    "base_version": "{polyfile.version}",
    "major_version": "{polyfile.localproperties.majorVersion}",

    // Commit information
    "commit_id": "{git.currentcommit.id}",
    "commit_message": "{git.currentcommit.message}",
    "commit_branch": "{git.branch}",

    // Commit URLs
    "commit_url": "{devenv.urls.commits_base}/{git.currentcommit.id}",
    "branch_url": "{devenv.urls.branch_base}/{git.branch}",

    // All commits
    //
    // The variable build.commits.names is a json object of all commit messages by their commit ID
    // The variable build.commits.urls is a json object of commit urls by their commit ID
    "included_commit_names": "{build.commits.messages}",
    "included_commit_urls": "{build.commits.urls}",

    // Included patches
    //
    // The variable build.patches.names is a json object of PR names included in the build, and their commit IDs
    // The variable build.patches.urls is a json object of PR names and the URLs of each PR
    "included_patch_names": "{build.patches.names}",
    "included_patch_urls": "{build.patches.urls}",

    // Changelog files
    "raw_changelog_link": "{devenv.urls.repopage.viewfile.raw}/changelogs/{polyfile.version}.md",
    "changelog_link": "{devenv.urls.repopage.viewfile}/changelogs/{polyfile.version}.md"
}
