{
    // XPM channels to release on for the project

    // Primary channel, only supports selecting ONE value
    // Required to be present, otherwise build will be rejected
    "primary-channel": {
        // Default channel will use the branch name
        // The property "always" is a required property
        "always": "{git.branch}",

        // Channels by patterns
        // Its also possible to do just `for` but that would use raw string matching
        // We need to use patterns due to the layout of the project
        "for-patterns": {
            "{git.branch}": {
                // Latest
                // Note: we might not be on major-next-...
                "major-next-develop": "major-{polyfile.localproperties.majorVersion}/development",
                "major-next-testing": "major-{polyfile.localproperties.majorVersion}/testing",
                "major-next-staging": "major-{polyfile.localproperties.majorVersion}/staging",
                "major-next-experimental": "major-{polyfile.localproperties.majorVersion}/experimental",
                "major-next": "major-{polyfile.localproperties.majorVersion}/latest",

                // LTS
                // Note: we might not be on lts-next-...
                "lts-next-develop": "lts-{polyfile.localproperties.majorVersion}/development",
                "lts-next-testing": "lts-{polyfile.localproperties.majorVersion}/testing",
                "lts-next-staging": "lts-{polyfile.localproperties.majorVersion}/staging",
                "lts-next-experimental": "lts-{polyfile.localproperties.majorVersion}/experimental",
                "lts-next": "lts-{polyfile.localproperties.majorVersion}/latest",

                // Major versions
                "major-*-develop": "major-{1}/development",
                "major-*-testing": "major-{1}/testing",
                "major-*-staging": "major-{1}/staging",
                "major-*-experimental": "major-{1}/experimental",
                "major-*": "major-{1}/latest",

                // LTS
                "lts-*-develop": "lts-{1}/development",
                "lts-*-testing": "lts-{1}/testing",
                "lts-*-staging": "lts-{1}/staging",
                "lts-*-experimental": "lts-{1}/experimental",
                "lts-*": "lts-{1}/latest"
            }
        }
    },

    // Additional channels
    // Supports multiple values
    "target-channels": {
        // Channels that are always built into
        // Can be a string or an array of strings
        "always": [],

        // For patterns (again, `for` is possible too)
        // Value for patterns can be a string or an array of strings
        "for-patterns": {
            // Structured release channels
            // See autoff.json for details on the design
            "{git.branch}": {
                // Handle latest builds
                "if": {
                    // Check latest
                    "expression": {"build.is-latest":true},

                    // If latest
                    "then": {
                        // Handle latest release buildss

                        // Latest releases
                        "major-*-develop": [
                            "development",
                            "major-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "major-*-testing": [
                            "testing",
                            "development",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "major-*-staging": [
                            "staging",
                            "testing",
                            "development",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "major-*-experimental": [
                            "experimental",
                            "staging",
                            "testing",
                            "development",
                            "major-{polyfile.localproperties.majorVersion}/experimental",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "major-*": [
                            "latest",
                            "experimental",
                            "staging",
                            "testing",
                            "development",
                            "major-{polyfile.localproperties.majorVersion}/latest",
                            "major-{polyfile.localproperties.majorVersion}/experimental",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development"
                        ],

                        // Latest LTS releases
                        "lts-*-develop": [
                            "lts/development",
                            "major-{polyfile.localproperties.majorVersion}/development",
                            "lts-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "lts-*-testing": [
                            "lts/testing",
                            "lts/development",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development",
                            "lts-{polyfile.localproperties.majorVersion}/testing",
                            "lts-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "lts-*-staging": [
                            "lts/staging",
                            "lts/testing",
                            "lts/development",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development",
                            "lts-{polyfile.localproperties.majorVersion}/staging",
                            "lts-{polyfile.localproperties.majorVersion}/testing",
                            "lts-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "lts-*-experimental": [
                            "lts/experimental",
                            "lts/staging",
                            "lts/testing",
                            "lts/development",
                            "major-{polyfile.localproperties.majorVersion}/experimental",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development",
                            "lts-{polyfile.localproperties.majorVersion}/experimental",
                            "lts-{polyfile.localproperties.majorVersion}/staging",
                            "lts-{polyfile.localproperties.majorVersion}/testing",
                            "lts-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "lts-*": [
                            "lts/latest",
                            "lts/experimental",
                            "lts/staging",
                            "lts/testing",
                            "lts/development",
                            "major-{polyfile.localproperties.majorVersion}/latest",
                            "major-{polyfile.localproperties.majorVersion}/experimental",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development",
                            "lts-{polyfile.localproperties.majorVersion}/latest",
                            "lts-{polyfile.localproperties.majorVersion}/experimental",
                            "lts-{polyfile.localproperties.majorVersion}/staging",
                            "lts-{polyfile.localproperties.majorVersion}/testing",
                            "lts-{polyfile.localproperties.majorVersion}/development"
                        ]
                    },

                    // Else, handle manually
                    "else": {
                        // Latest releases
                        "major-next-develop": [
                            "development",
                            "major-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "major-next-testing": [
                            "testing",
                            "development",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "major-next-staging": [
                            "staging",
                            "testing",
                            "development",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "major-next-experimental": [
                            "experimental",
                            "staging",
                            "testing",
                            "development",
                            "major-{polyfile.localproperties.majorVersion}/experimental",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "major-next": [
                            "latest",
                            "experimental",
                            "staging",
                            "testing",
                            "development",
                            "major-{polyfile.localproperties.majorVersion}/latest",
                            "major-{polyfile.localproperties.majorVersion}/experimental",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development"
                        ],

                        // Latest LTS releases
                        "lts-next-develop": [
                            "lts/development",
                            "major-{polyfile.localproperties.majorVersion}/development",
                            "lts-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "lts-next-testing": [
                            "lts/testing",
                            "lts/development",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development",
                            "lts-{polyfile.localproperties.majorVersion}/testing",
                            "lts-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "lts-next-staging": [
                            "lts/staging",
                            "lts/testing",
                            "lts/development",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development",
                            "lts-{polyfile.localproperties.majorVersion}/staging",
                            "lts-{polyfile.localproperties.majorVersion}/testing",
                            "lts-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "lts-next-experimental": [
                            "lts/experimental",
                            "lts/staging",
                            "lts/testing",
                            "lts/development",
                            "major-{polyfile.localproperties.majorVersion}/experimental",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development",
                            "lts-{polyfile.localproperties.majorVersion}/experimental",
                            "lts-{polyfile.localproperties.majorVersion}/staging",
                            "lts-{polyfile.localproperties.majorVersion}/testing",
                            "lts-{polyfile.localproperties.majorVersion}/development"
                        ],
                        "lts-next": [
                            "lts/latest",
                            "lts/experimental",
                            "lts/staging",
                            "lts/testing",
                            "lts/development",
                            "major-{polyfile.localproperties.majorVersion}/latest",
                            "major-{polyfile.localproperties.majorVersion}/experimental",
                            "major-{polyfile.localproperties.majorVersion}/staging",
                            "major-{polyfile.localproperties.majorVersion}/testing",
                            "major-{polyfile.localproperties.majorVersion}/development",
                            "lts-{polyfile.localproperties.majorVersion}/latest",
                            "lts-{polyfile.localproperties.majorVersion}/experimental",
                            "lts-{polyfile.localproperties.majorVersion}/staging",
                            "lts-{polyfile.localproperties.majorVersion}/testing",
                            "lts-{polyfile.localproperties.majorVersion}/development"
                        ],

                        // Non-latest major versions
                        "major-*-develop": [
                            "major-{1}/development"
                        ],
                        "major-*-testing": [
                            "major-{1}/testing",
                            "major-{1}/development"
                        ],
                        "major-*-staging": [
                            "major-{1}/staging",
                            "major-{1}/testing",
                            "major-{1}/development"
                        ],
                        "major-*-experimental": [
                            "major-{1}/experimental",
                            "major-{1}/staging",
                            "major-{1}/testing",
                            "major-{1}/development"
                        ],
                        "major-*": [
                            "major-{1}/latest",
                            "major-{1}/experimental",
                            "major-{1}/staging",
                            "major-{1}/testing",
                            "major-{1}/development"
                        ],

                        // Non-latest LTS versions
                        "lts-*-develop": [
                            "major-{1}/development",
                            "lts-{1}/development"
                        ],
                        "lts-*-testing": [
                            "major-{1}/testing",
                            "major-{1}/development",
                            "lts-{1}/testing",
                            "lts-{1}/development"
                        ],
                        "lts-*-staging": [
                            "major-{1}/staging",
                            "major-{1}/testing",
                            "major-{1}/development",
                            "lts-{1}/staging",
                            "lts-{1}/testing",
                            "lts-{1}/development"
                        ],
                        "lts-*-experimental": [
                            "major-{1}/experimental",
                            "major-{1}/staging",
                            "major-{1}/testing",
                            "major-{1}/development",
                            "lts-{1}/experimental",
                            "lts-{1}/staging",
                            "lts-{1}/testing",
                            "lts-{1}/development"
                        ],
                        "lts-*": [
                            "major-{1}/latest",
                            "major-{1}/experimental",
                            "major-{1}/staging",
                            "major-{1}/testing",
                            "major-{1}/development",
                            "lts-{1}/latest",
                            "lts-{1}/experimental",
                            "lts-{1}/staging",
                            "lts-{1}/testing",
                            "lts-{1}/development"
                        ]
                    }
                }
            }
        },

        // Fallback channel
        // Use the git branch name if unrecognized
        "fallback": [
            "{git.branch}"
        ]
    }
}
