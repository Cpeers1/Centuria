{
    // XPM repository settings
    // Used by the local repository and the public repository for OpenFeral

    // Channel settings
    "channel-settings": {
        // Default channel
        "default-channel": "latest",

        // Base channels
        // Supports either a channel name or channel object
        // Sub-channels can also be done without objects by just using `/` like the rest of the format, but unless a default is defined for the parent channel, the repository-wide default is used
        "base-channels": [
            // LTS and its sub-channels
            {
                "name": "lts",
                "default": "latest",
                "channels": [
                    "latest",
                    "experimental",
                    "staging",
                    "testing",
                    "develop"
                ]
            },

            // Other channels
            "latest",
            "experimental",
            "staging",
            "testing",
            "develop"
        ],

        // Order control
        // This supports patterns for sorting
        // Used by visual lists for sorting of channels and versions
        "channel-order": [
            // LTS
            "lts",
            "lts/latest",
            "lts/experimental",
            "lts/staging",
            "lts/develop",

            // Main channels
            "latest",
            "experimental",
            "staging",
            "testing",
            "develop",

            // LTS versions
            "lts-*",

            // Versions for a specific major game version
            "major-*"
        ]
    },

