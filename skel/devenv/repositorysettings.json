    // Repotype definitions
    "repotype-templates": {
        // Centuria server repotype config
        "centuria-server": {
            // Configuration name
            "name": "Base Centuria Server",

            // Base install path
            // Only allows relative paths relative to base root, doesnt permit going up beyond base root
            "default-base-install-path": ".",

            // Default local database path
            // Only allows relative paths
            // Write to centuria folder's xpm-database
            "default-base-localdata-path": "updater/xpm-database",

            // Prefer readonly mode
            // This means database-changing operations wont be perfomed unless install/modification operations are used
            "prefer-readonly": true,

            // FIXME: finish rest, eg output paths based on tags, other settings, and outputs into the upgrade folder for centuria servers instead of server root

            // Artifact types
            "enabled-artifact-types": [
                "server",
                "contentserver",
                "payload",
                "server-module",
                "contentoverrides",
                "ftm"
            ],

            // Enabled tags
            "enabled-tags": {
                // Always enabled tags
                "always": {
                    "server": true,
                    "payload": true,
                    "module": true,
                    "contentoverrides": true,
                    "ftm": true,
                    "jar": true,
                    "centuria": true
                }
            },

            // Default tag filters always used by XPM
            "default-tag-filters": [
                // The outer array acts as an ELSE list

                // Each array is a list of tags that must match
                // Array elements accepts string (tag present) or json object (tags with values that need to match)
                ["server", "payload", "module", "contentoverrides", "ftm", "jar"], // General feral server
                ["server", "payload", "module", "contentoverrides", "ftm", "jar", "centuria"] // Centuria
            ]
        }
    },

    // Artifact type definitions
    "artifact-types": {
        // Server artifacts
        // Used for server-specific packages
        "server": {
            "allowed-content-types": ["file", "folder"],
            
            "supported-tags": [
                "server",
                "payload",
                "module",
                "contentoverrides",
                "ftm",
                "jar",
                "xpk"
            ],
            "default-enabled-tags": [
                "server",
                "payload",
                "module",
                "contentoverrides",
                "ftm",
                "jar"
            ],
            "allow-other-tags": true
        },
        
        // Content Server artifacts
        // Used for contentserver-specific packages
        "contentserver": {
            "allowed-content-types": ["file", "folder"],
            
            "supported-tags": [
                "server",
                "module",
                "contentoverrides",
                "jar",
                "xpk"
            ],
            "default-enabled-tags": [
                "server",
                "module",
                "contentoverrides",
                "jar"
            ],
            "allow-other-tags": true
        },

        // Client artifacts
        // Used for client-specific packages
        "client": {
            "allowed-content-types": ["file", "folder"],
            
            "supported-tags": [
                "client",
                "payload",
                "library",
                "ftm",
                "xpk"
            ],
            "default-enabled-tags": [
                "client",
                "payload",
                "library",
                "ftm"
            ],
            "allow-other-tags": true
        },

        // Launcher artifacts
        // Used for client-specific packages
        "launcher": {
            "allowed-content-types": ["file", "folder"],
            
            "supported-tags": [
                "launcher",
                "extension",
                "library",
                "lpk",
                "jar",
                "xpk"
            ],
            "default-enabled-tags": [
                "launcher",
                "extension",
                "library",
                "lpk",
                "jar"
            ],
            "allow-other-tags": true
        },

        // Payload artifacts
        // Used for content to install into the base server / base client (used by server and launcher)
        "payload": {
            "allowed-content-types": "folder",
            
            "supported-tags": [
                "server",
                "client",
                "payload",
                "xpk"
            ],
            "default-enabled-tags": [
                "payload"
            ],
            "allow-other-tags": true
        },

        // Content overrides packages
        // Used for content to install into the content delivery server (used by server and launcher)
        "contentoverrides": {
            "allowed-content-types": "folder",
            
            "supported-tags": [
                "server",
                "contentoverrides"
            ],
            "default-enabled-tags": [
                "server",
                "contentoverrides"
            ],
            "allow-other-tags": true
        },

        // Module content type
        // Strictly server modules (used by server)
        "server-module": {
            "allowed-content-types": "file",
            
            "supported-tags": [
                "server",
                "module",
                "payload",
                "library",
                "jar",
                "ftm",
                "xpk"
            ],
            "default-enabled-tags": [
                "server",
                "module",
                "payload",
                "library",
                "jar",
                "ftm"
            ],
            "allow-other-tags": true
        },

        // Java libraries
        // Used by the server
        "java-library": {
            "allowed-content-types": "file",
            
            "supported-tags": [
                "server",
                "launcher",
                "library",
                "jar",
                "xpk"
            ],
            "default-enabled-tags": [
                "library",
                "jar"
            ],
            "allow-other-tags": true
        },

        // FTM mod content type
        // Strictly FeralTweaks mods (used by server and launcher)
        "ftm": {
            "allowed-content-types": "file",
            
            "supported-tags": [
                "server",
                "client",
                "library",
                "ftm",
                "xpk"
            ],
            "default-enabled-tags": [
                "library",
                "ftm"
            ],
            "allow-other-tags": true
        },

        // Jar artifact type
        // Typically used for dependency libraries like maven packages
        "jar": {
            "allowed-content-types": "file",
            
            "supported-tags": [
                "server",
                "launcher",
                "library",
                "jar",
                "xpk"
            ],
            "default-enabled-tags": [
                "library",
                "jar"
            ],
            "allow-other-tags": true
        },

        // XPK artifact type
        // Specifically XPM packages
        "xpk": {
            "allowed-content-types": "file",
            
            "supported-tags": [
                "server",
                "client",
                "launcher",
                "library",
                "module",
                "jar",
                "xpk",
                "ftm"
            ],
            "default-enabled-tags": [
                "library",
                "module",
                "jar",
                "xpk",
                "ftm"
            ],
            "allow-other-tags": true
        },

        // LPK artifact type
        // These are launcher component packages
        "lpk": {
            "allowed-content-types": "file",
            
            "supported-tags": [
                "launcher",
                "library",
                "jar",
                "xpk"
            ],
            "default-enabled-tags": [
                "launcher",
                "library",
                "jar"
            ],
            "allow-other-tags": true
        },

        // NPK artifact type
        // Nexus Runtime payloads
        "npk": {
            "allowed-content-types": "file",
            
            "supported-tags": [
                "server",
                "library",
                "module",
                "jar",
                "npk",
                "xpk"
            ],
            "default-enabled-tags": [
                "library",
                "module",
                "npk",
                "jar"
            ],
            "allow-other-tags": true
        },

        // Source library artifact type
        // Used for nexus runtime projects
        // Used when a package has an alternate source artifact for including source files of the library
        "nexus-source-library": {
            "allowed-content-types": "folder",
            
            "supported-tags": [
                "server",
                "library",
                "module",
                "nexus-source-library",
                "xpk"
            ],
            "default-enabled-tags": [
                "library",
                "module",
                "nexus-source-library"
            ],
            "allow-other-tags": true
        }
    }
}