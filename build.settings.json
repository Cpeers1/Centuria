{
    // Build settings file
    // Defines eg. buildinfo fields and other tools
    // See https://github.com/SkySwimmer/polyscript-runner/tree/HEAD/docs/user for documentation

    // FIXME: github release push task and jobs (and tag creation, make sure experimental and stable get releases, experimental should use a different tag to avoid conflicts)
    // FIXME: task and jobs to automatically increase the version of the develop branch
    // FIXME: builder settings for CI & CD

    // Plugins to use
    "plugins": [
        // Basic imports
        "shellscript-imports", // Shell-based files
        "directory-imports", // Directory imports
        "json-imports", // JSON imports
        "git" //, // Git support through JGit
        
        // Functionality
        // "expressions", // Conditions and expressions for variable assignment and conditional properties
        // "polytasks", // PolyTasks plugin, support for jobs and tasks
        // "polytasks-git", // Git integration for PolyTasks
        // "polytasks-jsongenerator", // Json generator polytask
        // "polytasks-xpmbuild", // XPM build polytask
        // "buildinfo-tools", // Build info generation tools
        // "xpmbuild-tools" // XPM builder tools (eg. builder based variables)
    ],

    // Assign variables test
    // If statements accept a single json object or an array of json objects
    // FIXME
    "if": [
        {
            "expression": {"{hello}":"b"},
            "then": {
                "assign-variables": {
                    "a": "b"
                }
            },
            "elseif": {
                "expression": {
                    "object": "",
                    "operator": "equals",
                    "comparison": ""
                },
                "then": {
                    "assign-variables": {
                        "test": "abc"
                    }
                }
            }
        },
        {
            "expression": [
                {"b":"e","operator":"=="},
                "AND",
                {"b":"e","operator":"!="},
                "AND",
                [
                    {"b":"e","operator":"<"},
                    "OR",
                    {"b":"e","operator":"<="}
                ]
            ],
            "then": {
                "assign-variables": {
                    "a": "b"
                }
            },
            "else": {
                "assign-variables": {
                    "b": "c"
                }
            },
            "elseif": {
                "expression": {"c":"d"},
                "then": {
                    "assign-variables": {
                        "hello": "world"
                    }
                },
                "elseif": {
                    "expression": {"de":"f"},
                    "then": {
                        "assign-variables": {
                            "hello": "world"
                        }
                    }
                }
            }
        }
    ],

    // Imports define additional variables by using a Importer to import a file into the variables environment
    // When using variable strings through `"{...}"` keywords, the value is assigned at runtime when read
    //
    // Variables are resolved when they are retrieved, not during parsing
    // This is achieved by wrapping the elements passed to contexts in a wrapper class
    "import": {
        // Polyfile is a bash script
        "polyfile": "polyfile.pcb",

        // Folders are loaded by looking for any metadata-providing files
        // It finds files of any of the given filetypes above and imports them
        // Eg. a field named `repository` in `environment/urls.json` would be imported as `devenv.urls.repository`
        "devenv": "environment",

        // Build info
        "buildinfo": "environment/buildinfo.json",

        // Breaking versions
        "versioncontrol": "settings/versioncontrol.json"
    },

    // Overload imports are files directly imported into the current context
    "import-overloads": [
        // Build properties
        "settings/buildsettings.settings.json",
        "settings/buildpackages.settings.json",
        "settings/buildbranches.settings.json",
        "settings/buildinfogen.settings.json",
        "settings/versionincrement.settings.json",
        "settings/githubrelease.settings.json",
        "settings/deployment.settings.json",

        // User environment settings
        "environment/build.settings.json"
    ],

    // Scripts for each file pattern thats loaded to preload into the shell prior to dumping variables
    "shellenv": {
        "polyfile.pcb": [
            "deps/centuria-polytool/util/polyenv.sh" // Polyfile wrapper script implementing basic polyfile commands and emitting the properties blocks
        ]
    },
    
    // Importer patterns
    // Used by import system to resolve the importer to use for each file type
    // Importer types are implemented by plugins
    "importers": {
        // Settings json files are treated as imports through the same parser that is used to load this file
        // The difference between how `import` files are loaded and how 
        // We want this one defined first to prevent *.json matching this
        "*.settings.json": "import",

        // Polyfile is interpreted as shell
        "*.pcb": "shellscript",

        // We want json files to be located directly from directories, using type `json` will also parse variables using the current context, 
        // if needed, we can use "jsonraw" to parse without handling variables
        "*.json": "json",

        // Directory imports (fallback)
        "*": "directory"
    }
}