{
    // Build info and changelog generation settings (both are under the same tool)
    "buildinfo": {
        // Build storage settings
        "config": {
            // The cache directory is a non-permanent folder that should be gitignored
            "cache-dir": ".buildinfo/cache/buildinfocache",

            // The versions folder should be included in the repository
            // Versions are stored in this directory for inheritence to work based on commit ID
            "versions-dir": ".buildinfo/versions",

            // Current version is a cache, it should be gitignored
            // We store it per project version
            "current-version-dir": ".buildinfo/cache/currentversion-{polyfile.version}",

            // URL support
            "support-commit-urls": true,
            "support-pr-urls": true,

            // URL bases
            "commit-url-base": "{devenv.urls.commits_base}",
            "pr-url-base": "{devenv.urls.prs_base}"
        },

        // Inheritance control
        "inheritance-rules": {
            // Shared properties
            "always": {
                // The scope is used to group versions together that can be inherited
                // Without this property, inheritance is disabled
                //
                // Its set to the polyfile-defined version so we only inherit build information
                // related to the current minor version
                "inheritance-scope": "{polyfile.version}",

                // Defines which types can be inherited
                // Leaving empty will allow builds of any type
                "inherit-from-type": [
                    "development",
                    "testing",
                    "staging",
                    "experimental",
                    "stable"
                ],

                // Controls what to inherit
                // This is based on properties
                // Properties are merged using json merger tactics
                "inherit": [
                    // Inherit commits
                    "commits",

                    // Inherit pull requests
                    "pullrequests",

                    // Inherit specific properties from build info
                    "buildinfo.fixed_issues"
                ]
            },

            // For patterns
            // Its also possible to do just `for` but that would use raw string matching
            // We need to use patterns due to the layout of the project
            "for-patterns": {
                "{git.branch}": {
                    "lts-*-develop": {
                        // The build type controls which builds can be inherited by the local build
                        // This assigns the current build type
                        "current-type": "development"
                    },
                    "lts-*-testing": {
                        // The build type controls which builds can be inherited by the local build
                        // This assigns the current build type
                        "current-type": "testing"
                    },
                    "lts-*-staging": {
                        // The build type controls which builds can be inherited by the local build
                        // This assigns the current build type
                        "current-type": "staging"
                    },
                    "lts-*-experimental": {
                        // The build type controls which builds can be inherited by the local build
                        // This assigns the current build type
                        "current-type": "experimental"
                    },
                    "lts-*": {
                        // The build type controls which builds can be inherited by the local build
                        // This assigns the current build type
                        "current-type": "stable"
                    },
                    "major-*-develop": {
                        // The build type controls which builds can be inherited by the local build
                        // This assigns the current build type
                        "current-type": "development"
                    },
                    "major-*-testing": {
                        // The build type controls which builds can be inherited by the local build
                        // This assigns the current build type
                        "current-type": "testing"
                    },
                    "major-*-staging": {
                        // The build type controls which builds can be inherited by the local build
                        // This assigns the current build type
                        "current-type": "staging"
                    },
                    "major-*-experimental": {
                        // The build type controls which builds can be inherited by the local build
                        // This assigns the current build type
                        "current-type": "experimental"
                    },
                    "major-*": {
                        // The build type controls which builds can be inherited by the local build
                        // This assigns the current build type
                        "current-type": "stable"
                    }
                }
            },

            // Fallback rules
            // Used when no patterns match
            "fallback": {
                // The build type controls which builds can be inherited by the local build
                // This assigns the current build type
                "current-type": "development"
            }
        },

        // Build properties
        "assign-properties": {
            // Shared properties
            // Acts as defaults, eg. channels that arent preconfigured will use these, but also any field here is present on all channels
            // The tool always includes properties `commit` (current commit), `patches` (pull requests included, array of PR info objects, with alternate patches.names and patches.urls), `commits` (commits included, array of commit objects, with alternate commits.messages and commits.urls)
            // The tool includes `buildnumber` if possible based upon `buildscope`
            "always": {
                // Type name
                "typename": "{polyfile.localproperties.updateType}",

                // Version title
                "versiontitle": "{build.typename} {build.versionpretty} - Development Build #{build.buildnumber} ({build.commit.shortname})",

                // Version value
                "version": "{polyfile.version}",

                // Version name
                "versionpretty": "{polyfile.localproperties.versionPretty}",

                // Base version
                "baseversion": "{polyfile.version}",

                // Build info json
                "buildinfo": "{devenv.buildinfo}",

                // Build breaking versions
                "breakingversions": "{versioncontrol.breakingversions}",

                // Build data versions
                "dataversions": "{versioncontrol.dataversions}"
            },

            // Properties for each channel based on patterns
            // Again, just `for` would work too, but we want to use pattern matching
            "for-patterns": {
                "{git.branch}": {
                    // LTS development build
                    "lts-*-develop": {
                        "versiontitle": "{build.typename} {build.versionpretty} LTS - Development Build #{build.buildnumber} ({build.commit.shortname})",
                        "version": "{polyfile.version}-develop-{build.buildnumber}-{build.commit.shortname}", // Build version
                        "buildscope": "{polyfile.version}-develop", // Used to find the build number
                        "buildtype": "development"
                    },

                    // LTS testing build
                    "lts-*-testing": {
                        "versiontitle": "{build.typename} {build.versionpretty} LTS - Testing Build #{build.buildnumber}",
                        "version": "{polyfile.version}-devtest-{build.buildnumber}", // Build version
                        "buildscope": "{polyfile.version}-devtest", // Used to find the build number
                        "buildtype": "testing"
                    },

                    // LTS staging build
                    "lts-*-staging": {
                        "versiontitle": "{build.typename} {build.versionpretty} LTS - Staging Build #{build.buildnumber}",
                        "version": "{polyfile.version}-prerelease-{build.buildnumber}", // Build version
                        "buildscope": "{polyfile.version}-prerelease", // Used to find the build number
                        "buildtype": "staging"
                    },
                    
                    // LTS experimental build
                    "lts-*-experimental": {
                        "versiontitle": "{build.typename} {build.versionpretty} LTS - Experimental Build #{build.buildnumber}",
                        "version": "{polyfile.version}-prerelease-{build.buildnumber}", // Build version
                        "buildscope": "{polyfile.version}-prerelease", // Used to find the build number
                        "buildtype": "experimental"
                    },

                    // LTS stable build
                    "lts-*": {
                        "versiontitle": "{build.typename} {build.versionpretty} LTS Release",
                        "version": "{polyfile.version}", // Build version
                        "buildscope": "{polyfile.version}", // Used to find the build number
                        "buildtype": "stable"
                    },

                    // Development build
                    "major-*-develop": {
                        "versiontitle": "{build.typename} {build.versionpretty} - Development Build #{build.buildnumber} ({build.commit.shortname})",
                        "version": "{polyfile.version}-develop-{build.buildnumber}-{build.commit.shortname}", // Build version
                        "buildscope": "{polyfile.version}-develop", // Used to find the build number
                        "buildtype": "development"
                    },

                    // Testing build
                    "major-*-testing": {
                        "versiontitle": "{build.typename} {build.versionpretty} - Testing Build #{build.buildnumber}",
                        "version": "{polyfile.version}-devtest-{build.buildnumber}", // Build version
                        "buildscope": "{polyfile.version}-devtest", // Used to find the build number
                        "buildtype": "testing"
                    },

                    // Staging build
                    "major-*-staging": {
                        "versiontitle": "{build.typename} {build.versionpretty} - Staging Build #{build.buildnumber}",
                        "version": "{polyfile.version}-prerelease-{build.buildnumber}", // Build version
                        "buildscope": "{polyfile.version}-prerelease", // Used to find the build number
                        "buildtype": "staging"
                    },

                    // Experimental build
                    "major-*-experimental": {
                        "versiontitle": "{build.typename} {build.versionpretty} - Experimental Build #{build.buildnumber}",
                        "version": "{polyfile.version}-prerelease-{build.buildnumber}", // Build version
                        "buildscope": "{polyfile.version}-prerelease", // Used to find the build number
                        "buildtype": "experimental"
                    },
                    
                    // Stable build
                    "major-*": {
                        "versiontitle": "{build.typename} {build.versionpretty} Release",
                        "version": "{polyfile.version}", // Build version
                        "buildscope": "{polyfile.version}", // Used to find the build number
                        "buildtype": "stable"
                    }
                }
            },

            // Fallback
            // Used when patterns do not match
            "fallback": {
                // Use development build when no matches are made
                "versiontitle": "{build.typename} {build.versionpretty} - Development Build #{build.buildnumber} ({build.commit.shortname})",
                "version": "{polyfile.version}-develop-{build.buildnumber}-{build.commit.shortname}", // Build version
                "buildscope": "{polyfile.version}-develop", // Used to find the build number
                "buildtype": "development" // Build type
            }
        }
    }
}