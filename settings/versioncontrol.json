{
    // Vulnerability disclosure
    // Controls if this version should be avoided by XPM and if upgrades should be urged
    "vulnerabilitiesPresent": false,
    "vulnerabilitiesPresentRequireUpgrade": false,

    // List of vulnerabilities and their details
    // Expects: vulnerability identifiers and description messages
    "vulnerabilitiesDetails": {
    },

    // Build breaking version data
    // Used for dependencies to have better version control for what they depend on
    // Eg. modules can add version requirements for specific parts of the server
    // If used properly, downgrades will still eg. use latest compatible, and avoid versions that introduce breaking changes that would break compatibility
    // This statement defines the local packages component versions that are used by projects depending on the local project to ensure compatibility
    "breakingversions": {
        "baseserver": "v2",
        "moduleapi": "v2"   
    },

    // Data versions
    // These prevent downgrading to eg. incompatible player data
    "dataversions": {
        "playerdata": "v2"
    },

    // Dependency packages
    "dependencies": {
        // Required dependencies
        // Format: <id> [<checkstring>]
        "require": [
            "libxpm",
            "gson",
            "commons-compress",
            "gson >= 2.8",
            "test >= 2.8 && < 3.0",
            "test",
            "connective-http >= 1.0.0.A20"
            // FIXME: real dependencies
        ],

        // Optional dependencies
        // Format: <id> [<checkstring>]
        "optional": [
        ],

        // Conflicts
        // Format: <id> [<checkstring>]
        "conflicts": [
        ],

        // Dependencies that need to load AFTER the local dependency
        // Format: <id>
        "loadBefore": [
            "test"
        ],

        // Version fine-tuned control
        // Format: <id>: <expressions>
        "versionControl": {
            // Connective HTTP
            // Each version control statement adds BreakingVersion requirements
            // Value accepts: array of json objects or single json object
            // Outer array is an ELSE list, each json object is an AND list
            "connective-http": {
                // API breaking versions
                // These help XPM figure out which versions are truly compatible
                // Eg. connective will only change "handlers" when previous versions are rendered inoperable with the update (eg. syntax changes that cannot have deprecations)
                "handlers": "v2", // Handler API v2
                "serverbase": "v2" // Server base API v2
            },

            // XPM
            "libxpm": {
                // Base XPM engine API
                "engine": "v1"
            },

            // Test
            // FIXME
            "test": [
                // Support v1
                {
                    "base": "v1"
                },

                // Support v2 with limitations
                {
                    "base": "v2",
                    "api": "v1"
                }
            ]
        }
    },
    
    // Recommended packages
    // These are packages installed in recommended mode when using eg. a graphical installer, or listed as recommended extras on XPM
    "recommendedPackages": [
        "centuria-feraltweaks",
        "centuria-discordrpc",
        "centuria-playasnpcs",
        "centuria-gcsforferal",
        "centuria-emuferalonline",
        "centuria-earlyaccess-1.8"
    ]
}