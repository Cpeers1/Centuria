{
    // Branch-related tasks
    // Setting up missing default branches, fetching upstream, finding if the current build is a latest build, and pushing of branches for a new major version / new lts version
    "tasks": {
        // Branch init
        "initbranches": {
            // The "on" statement controls when to run the task
            // Allowed values: setup (on setup), earlyevaluate (on evaluate cycle - "early" phase), evaluate (on evaluate cycle - "evaluate" phase), lateevaluate (on evaluate cycle - "late" phase), called (only when invoked)
            // Default value: called
            "on": "setup",
            "jobs": {
                // Fetch upstream
                // This allows us to track remote branches that are created
                "fetch": {
                    // Job properties
                    "name": "Fetch remote Git repository",
                    "type": "git-fetch",

                    // Settings
                    "mode": "always",
                    "all": true // All branches

                    // We can also specify branches to fetch but we fetch all instead
                },

                // Set up variables through git conditions
                // Here we check if the upstream major-next and lts-next versions match local branch
                "vars": {
                    // Job properties
                    "name": "Set up variables",
                    "type": "git-conditions",

                    // Expressions
                    "expressions": {
                        "for-patterns": {
                            "{git.branch}": {
                                "major-next-develop": [
                                    {
                                        "expression": {"true":"true"},
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }
                                ],
                                "major-next-testing": [
                                    {
                                        "expression": {"true":"true"},
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }
                                ],
                                "major-next-staging": [
                                    {
                                        "expression": {"true":"true"},
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }
                                ],
                                "major-next-experimental": [
                                    {
                                        "expression": {"true":"true"},
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }
                                ],
                                "major-next": [
                                    {
                                        "expression": {"true":"true"},
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }
                                ],
                                "lts-next-develop": [
                                    {
                                        "expression": {"true":"true"},
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }
                                ],
                                "lts-next-testing": [
                                    {
                                        "expression": {"true":"true"},
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }
                                ],
                                "lts-next-staging": [
                                    {
                                        "expression": {"true":"true"},
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }
                                ],
                                "lts-next-experimental": [
                                    {
                                        "expression": {"true":"true"},
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }
                                ],
                                "lts-next": [
                                    {
                                        "expression": {"true":"true"},
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }
                                ],
                                "major-*-develop": [
                                    {
                                        // Scope
                                        // Accepts: relative-to (remote or local), remote (the remote to use), branch (the branch to use), commit (the commit to use)
                                        "scope": {
                                            // Use remote
                                            "relative-to": "remote",

                                            // Remote to use, @default@ is default remote
                                            "remote": "@default@",

                                            // Branch to use
                                            "branch": "major-next-develop"
                                        },

                                        // Expression
                                        // Values like `commit`, `remote`, and `branch` are relative to the scope
                                        "expression": {"{commit.id}":"{git.currentcommit.id}"},

                                        // Handler
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }   
                                ],
                                "major-*-testing": [
                                    {
                                        // Scope
                                        // Accepts: relative-to (remote or local), remote (the remote to use), branch (the branch to use), commit (the commit to use)
                                        "scope": {
                                            // Use remote
                                            "relative-to": "remote",

                                            // Remote to use, @default@ is default remote
                                            "remote": "@default@",

                                            // Branch to use
                                            "branch": "major-next-testing"
                                        },

                                        // Expression
                                        // Values like `commit`, `remote`, and `branch` are relative to the scope
                                        "expression": {"{commit.id}":"{git.currentcommit.id}"},

                                        // Handler
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }   
                                ],
                                "major-*-staging": [
                                    {
                                        // Scope
                                        // Accepts: relative-to (remote or local), remote (the remote to use), branch (the branch to use), commit (the commit to use)
                                        "scope": {
                                            // Use remote
                                            "relative-to": "remote",

                                            // Remote to use, @default@ is default remote
                                            "remote": "@default@",

                                            // Branch to use
                                            "branch": "major-next-staging"
                                        },

                                        // Expression
                                        // Values like `commit`, `remote`, and `branch` are relative to the scope
                                        "expression": {"{commit.id}":"{git.currentcommit.id}"},

                                        // Handler
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }   
                                ],
                                "major-*-experimental": [
                                    {
                                        // Scope
                                        // Accepts: relative-to (remote or local), remote (the remote to use), branch (the branch to use), commit (the commit to use)
                                        "scope": {
                                            // Use remote
                                            "relative-to": "remote",

                                            // Remote to use, @default@ is default remote
                                            "remote": "@default@",

                                            // Branch to use
                                            "branch": "major-next-experimental"
                                        },

                                        // Expression
                                        // Values like `commit`, `remote`, and `branch` are relative to the scope
                                        "expression": {"{commit.id}":"{git.currentcommit.id}"},

                                        // Handler
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }   
                                ],
                                "major-*": [
                                    {
                                        // Scope
                                        // Accepts: relative-to (remote or local), remote (the remote to use), branch (the branch to use), commit (the commit to use)
                                        "scope": {
                                            // Use remote
                                            "relative-to": "remote",

                                            // Remote to use, @default@ is default remote
                                            "remote": "@default@",

                                            // Branch to use
                                            "branch": "major-next"
                                        },

                                        // Expression
                                        // Values like `commit`, `remote`, and `branch` are relative to the scope
                                        "expression": {"{commit.id}":"{git.currentcommit.id}"},

                                        // Handler
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }   
                                ],
                                "lts-*-develop": [
                                    {
                                        // Scope
                                        // Accepts: relative-to (remote or local), remote (the remote to use), branch (the branch to use), commit (the commit to use)
                                        "scope": {
                                            // Use remote
                                            "relative-to": "remote",

                                            // Remote to use, @default@ is default remote
                                            "remote": "@default@",

                                            // Branch to use
                                            "branch": "lts-next-develop"
                                        },

                                        // Expression
                                        // Values like `commit`, `remote`, and `branch` are relative to the scope
                                        "expression": {"{commit.id}":"{git.currentcommit.id}"},

                                        // Handler
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }   
                                ],
                                "lts-*-testing": [
                                    {
                                        // Scope
                                        // Accepts: relative-to (remote or local), remote (the remote to use), branch (the branch to use), commit (the commit to use)
                                        "scope": {
                                            // Use remote
                                            "relative-to": "remote",

                                            // Remote to use, @default@ is default remote
                                            "remote": "@default@",

                                            // Branch to use
                                            "branch": "lts-next-testing"
                                        },

                                        // Expression
                                        // Values like `commit`, `remote`, and `branch` are relative to the scope
                                        "expression": {"{commit.id}":"{git.currentcommit.id}"},

                                        // Handler
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }   
                                ],
                                "lts-*-staging": [
                                    {
                                        // Scope
                                        // Accepts: relative-to (remote or local), remote (the remote to use), branch (the branch to use), commit (the commit to use)
                                        "scope": {
                                            // Use remote
                                            "relative-to": "remote",

                                            // Remote to use, @default@ is default remote
                                            "remote": "@default@",

                                            // Branch to use
                                            "branch": "lts-next-staging"
                                        },

                                        // Expression
                                        // Values like `commit`, `remote`, and `branch` are relative to the scope
                                        "expression": {"{commit.id}":"{git.currentcommit.id}"},

                                        // Handler
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }   
                                ],
                                "lts-*-experimental": [
                                    {
                                        // Scope
                                        // Accepts: relative-to (remote or local), remote (the remote to use), branch (the branch to use), commit (the commit to use)
                                        "scope": {
                                            // Use remote
                                            "relative-to": "remote",

                                            // Remote to use, @default@ is default remote
                                            "remote": "@default@",

                                            // Branch to use
                                            "branch": "lts-next-experimental"
                                        },

                                        // Expression
                                        // Values like `commit`, `remote`, and `branch` are relative to the scope
                                        "expression": {"{commit.id}":"{git.currentcommit.id}"},

                                        // Handler
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }   
                                ],
                                "lts-*": [
                                    {
                                        // Scope
                                        // Accepts: relative-to (remote or local), remote (the remote to use), branch (the branch to use), commit (the commit to use)
                                        "scope": {
                                            // Use remote
                                            "relative-to": "remote",

                                            // Remote to use, @default@ is default remote
                                            "remote": "@default@",

                                            // Branch to use
                                            "branch": "lts-next"
                                        },

                                        // Expression
                                        // Values like `commit`, `remote`, and `branch` are relative to the scope
                                        "expression": {"{commit.id}":"{git.currentcommit.id}"},

                                        // Handler
                                        "then": {
                                            // Jobs to run
                                            "assign": {
                                                "type": "assign-variables",
                                                "scope": "local",
                                                "variables": {
                                                    "build.is-latest": true
                                                }
                                            }
                                        }
                                    }   
                                ]
                            }
                        }
                    }
                }
            }
        },

        // Branch publish
        "publishbranches": {
            "jobs": {
                // Fetch upstream
                // Just to guarantee our info about the remote is up to date
                "fetch": {
                    // Job properties
                    "name": "Fetch remote Git repository",
                    "type": "git-fetch",

                    // Settings
                    "mode": "always",
                    "all": true // All branches
                },

                // Create needed branches
                "createbranches": {
                    // Job properties
                    "name": "Create missing branches",
                    "type": "git-createbranches",
                    
                    // Mode
                    // Create only when not already present (when using "always" or not specifying mode, it will cause an error if the branch exists)        
                    "mode": "ifneeded",

                    // Track upstream (if available remote)
                    "track-upstream": true,
                    
                    // Branches to create
                    "branches": {
                        // Default channels
                        "always": {
                            "major-next-develop": "{git.branch}",
                            "major-next-testing": "{git.branch}",
                            "major-next-staging": "{git.branch}",
                            "major-next-experimental": "{git.branch}",
                            "major-next": "{git.branch}",
                            "lts-next-develop": "{git.branch}",
                            "lts-next-testing": "{git.branch}",
                            "lts-next-staging": "{git.branch}",
                            "lts-next-experimental": "{git.branch}",
                            "lts-next": "{git.branch}",
                        },

                        // Staging of new major versions and transitions to LTS
                        "for-patterns": {
                            "{git.branch}": {
                                // Creating new branches for the version once it hits staging
                                "major-next-staging": {
                                    "major-{polyfile.localproperties.majorVersion}": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-experimental": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-staging": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-testing": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-develop": "{git.branch}"
                                },
                                "lts-next-staging": {
                                    "lts-{polyfile.localproperties.majorVersion}": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-experimental": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-staging": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-testing": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-develop": "{git.branch}"
                                },

                                // Ignore major-next-... and lts-next-...
                                "major-next-*": {},
                                "lts-next-*": {},
                                "major-next": {},
                                "lts-next": {},

                                // Missing branches of the current version
                                "major-*": {
                                    "major-{polyfile.localproperties.majorVersion}": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-experimental": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-staging": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-testing": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-develop": "{git.branch}"
                                },
                                "lts-*": {
                                    "lts-{polyfile.localproperties.majorVersion}": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-experimental": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-staging": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-testing": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-develop": "{git.branch}"
                                }
                            }
                        }
                    }
                },

                // Push to relevant branches
                "pushbranches": {
                    // Job properties
                    "name": "Push created branches to upstream",
                    "type": "git-pushbranches",

                    // Mode
                    // Only when not present ("always" = push always (if up to date, error), "ifneeded" = push local if not up to date with remote, "ifabsent" = only push if remote lacks the given branches)
                    "mode": "ifabsent",

                    // Branches to push
                    "branches": {
                        // Default channels that are needed
                        "always": [
                            "major-next-develop",
                            "major-next-testing",
                            "major-next-staging",
                            "major-next-experimental",
                            "major-next",
                            "lts-next-develop",
                            "lts-next-testing",
                            "lts-next-staging",
                            "lts-next-experimental",
                            "lts-next"
                        ],

                        // Staging new versions
                        "for-patterns": {
                            "{git.branch}": {
                                // New branches for the current version that hit staging
                                "major-next-staging": [
                                    "major-{polyfile.localproperties.majorVersion}",
                                    "major-{polyfile.localproperties.majorVersion}-experimental",
                                    "major-{polyfile.localproperties.majorVersion}-staging",
                                    "major-{polyfile.localproperties.majorVersion}-testing",
                                    "major-{polyfile.localproperties.majorVersion}-develop"
                                ],
                                "lts-next-staging": [
                                    "lts-{polyfile.localproperties.majorVersion}",
                                    "lts-{polyfile.localproperties.majorVersion}-experimental",
                                    "lts-{polyfile.localproperties.majorVersion}-staging",
                                    "lts-{polyfile.localproperties.majorVersion}-testing",
                                    "lts-{polyfile.localproperties.majorVersion}-develop"
                                ],

                                // Ignore major-next-... and lts-next-...
                                "major-next-*": {},
                                "lts-next-*": {},
                                "major-next": {},
                                "lts-next": {},

                                // Missing branches of the current version
                                "major-*": {
                                    "major-{polyfile.localproperties.majorVersion}": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-experimental": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-staging": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-testing": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-develop": "{git.branch}"
                                },
                                "lts-*": {
                                    "lts-{polyfile.localproperties.majorVersion}": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-experimental": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-staging": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-testing": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-develop": "{git.branch}"
                                }
                            }
                        }
                    }
                },

                // Delete branches if needed
                "if": {
                    "expression": {"{git.branch}":"lts-next-staging","operator":"~="},
                    "then": {
                        // Create the job, we are staging a new LTS release
                        // FIXME: make sure the if statements place the task at the correct index, must happen BEFORE checkout
                        "deletebranches": {
                            // Job properties
                            "name": "Delete old major-{polyfile.localproperties.majorVersion} branches",
                            "type": "git-deletebranches",

                            // Settings
                            // Mode for deletion, accepts "always" (errors if absent)
                            "mode": "ifpresent",

                            // Delete on remote and local
                            // Always uses default remote
                            "on-remote": true,
                            "on-local": true,

                            // Branches to delete
                            "branches": {
                                "for-patterns": {
                                    "{git.branch}": {
                                        // Delete old major-... branches
                                        "lts-next-staging": [
                                            "major-{polyfile.localproperties.majorVersion}",
                                            "major-{polyfile.localproperties.majorVersion}-experimental",
                                            "major-{polyfile.localproperties.majorVersion}-staging",
                                            "major-{polyfile.localproperties.majorVersion}-testing",
                                            "major-{polyfile.localproperties.majorVersion}-develop"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },

                // Checkout for major-next/lts-next to the associated major branch
                "checkout": {
                    // Job properties
                    "name": "Checkout",
                    "type": "git-checkout",

                    // Mode
                    // Only when not already on the target (if set to "always" or if absent, this function will error if already on the branch)
                    "mode": "ifneeded",

                    // Checkout to the given new branch where needed
                    "for": {
                        "{git.branch}": {
                            "major-next-staging": "major-{polyfile.localproperties.majorVersion}-staging",
                            "lts-next-staging": "lts-{polyfile.localproperties.majorVersion}-staging"
                        }
                    }
                }
            }
        },

        // Post-git-push jobs
        // Runs checkout on the local repository when pushing to a staging branch
        // FIXME: create polytool post-restore task that creates the git hook calling this job after a push is run
        "postgitpush": {
            "jobs": {
                "createbranches": {
                    // Job properties
                    "name": "Create missing branches",
                    "type": "git-createbranches",
                    
                    // Mode
                    // Create only when not already present (when using "always" or not specifying mode, it will cause an error if the branch exists)        
                    "mode": "ifneeded",

                    // Track upstream (if available remote)
                    "track-upstream": true,
                    
                    // Branches to create
                    "branches": {
                        // Default channels
                        "always": {
                            "major-next-develop": "{git.branch}",
                            "major-next-testing": "{git.branch}",
                            "major-next-staging": "{git.branch}",
                            "major-next-experimental": "{git.branch}",
                            "major-next": "{git.branch}",
                            "lts-next-develop": "{git.branch}",
                            "lts-next-testing": "{git.branch}",
                            "lts-next-staging": "{git.branch}",
                            "lts-next-experimental": "{git.branch}",
                            "lts-next": "{git.branch}"
                        },

                        // Staging of new major versions and transitions to LTS
                        "for-patterns": {
                            "{git.branch}": {
                                "major-next-staging": {
                                    "major-{polyfile.localproperties.majorVersion}": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-experimental": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-staging": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-testing": "{git.branch}",
                                    "major-{polyfile.localproperties.majorVersion}-develop": "{git.branch}"
                                },
                                "lts-next-staging": {
                                    "lts-{polyfile.localproperties.majorVersion}": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-experimental": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-staging": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-testing": "{git.branch}",
                                    "lts-{polyfile.localproperties.majorVersion}-develop": "{git.branch}"
                                }
                            }
                        }
                    }
                },

                // Checkout for major-next/lts-next to the associated major branch
                "checkout": {
                    // Job properties
                    "name": "Checkout",
                    "type": "git-checkout",

                    // Mode
                    // Only when not already on the target (if set to "always" or if absent, this function will error if already on the branch)
                    "mode": "ifneeded",

                    // Checkout to the given new branch where needed
                    "for": {
                        "{git.branch}": {
                            "major-next-staging": "major-{polyfile.localproperties.majorVersion}-staging",
                            "lts-next-staging": "lts-{polyfile.localproperties.majorVersion}-staging"
                        }
                    }
                }
            }
        }
    }
}