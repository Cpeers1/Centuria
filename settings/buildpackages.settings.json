{
    // Builder task
    "tasks": {
        // Package builder
        "buildpackages": {
            // Job properties
            "name": "Build XPM packages",
            "type": "xpm-build",

            // Build project
            "project": "{buildsettings.xpm-build}"
        }
    },

    // Package project build settings
    "xpm-build": "{buildsettings.xpm-build}",

    // Shared property
    "buildsettings": {
        // Build properties for XPM
        // Used by xpmbuild and the build job
        "xpm-build": {
            // Default repository settings
            "local-repository": "{devenv.repositorysettings}",

            // Packages
            "produce-packages": [
                // Server package
                {
                    // Package details
                    "id": "{devenv.packagesettings.id}",
                    "name": "{devenv.packagesettings.name}",

                    // Package implements statements
                    "implements": "{devenv.packagesettings.implements}",

                    // Aliases are used by search to find packages
                    "aliases": "{devenv.packagesettings.aliases}",

                    // Query tags
                    "query-tags": "{devenv.packagesettings.query-tags}",

                    // Create builds
                    "produce-builds": [
                        {
                            // Build info
                            "version": "{devenv.packagebuildsettings.version}",
                            "manifest": "{devenv.packagebuildsettings.manifest}",

                            // Changelog
                            "changelogFile": "{devenv.packagebuildsettings.changelogFile}",

                            // Metadata
                            "metadata": "{devenv.packagebuildsettings.metadata}",

                            // Vulnerability disclosure / alerting
                            "vulnerabilitiesPresent": "{devenv.packagebuildsettings.vulnerabilitiesPresent}",
                            "vulnerabilitiesPresentRequireUpgrade": "{devenv.packagebuildsettings.vulnerabilitiesPresentRequireUpgrade}",

                            // List of vulnerabilities and their details
                            "vulnerabilitiesDetails": "{devenv.packagebuildsettings.vulnerabilitiesDetails}",

                            // Build breaking version data
                            "breakingVersions": "{devenv.packagebuildsettings.breakingVersions}",

                            // Data versions
                            // These prevent downgrading to eg. incompatible player data
                            "dataVersions": "{devenv.packagebuildsettings.dataVersions}",

                            // Recommended packages
                            // These are packages installed in recommended mode when using eg. a graphical installer, or listed as recommended extras on XPM
                            "recommendedPackages": "{devenv.packagebuildsettings.recommendedPackages}",

                            // Artifacts
                            "artifacts": "{devenv.packagebuildartifacts}",
                            
                            // Channels to build to
                            "channels": "{devenv.packagebuildchannels}"
                        }
                    ]
                }
            ]
        }
    }
}