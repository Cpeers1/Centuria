{
    // Build info generation tasks
    "tasks": {
        "genbuildinfo": {
            "jobs": {
                "genbuildinfo": {
                    // Job properties
                    "name": "Generate build info files",
                    "type": "jsongenerator",

                    // Source file
                    "source": "environment/buildinfo.json",

                    // Where to emit
                    "targets": [
                        "currentbuildinfo.json",
                        "src/main/resources/buildinfo.json"
                    ]
                }
            }
        }
    }
}